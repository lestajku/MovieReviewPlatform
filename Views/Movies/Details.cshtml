@model MovieDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var ownReview = Model.Reviews.FirstOrDefault(r => r.IsMine);
}

<a class="btn btn-ghost" asp-controller="Movies" asp-action="Index" style="padding-left:0;margin-bottom:20px">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
    Back to movies
</a>

<div class="detail-head">
    <div class="detail-poster">
        @if (!string.IsNullOrEmpty(Model.PosterUrl))
        {
            <span class="poster poster-img"><img src="@Model.PosterUrl" alt="@Model.Title poster" /></span>
        }
        else
        {
            <span class="poster">@Model.Title</span>
        }
    </div>

    <div class="detail-body">
        <h1 style="margin:0 0 8px;font-size:34px">@Model.Title</h1>
        <div class="detail-meta">
            <span>@Model.Year</span>
            <span>@Model.Duration min</span>
            <span>Directed by @Model.Director</span>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px">
            @foreach (var genre in Model.Genres)
            {
                <span class="tag tag-outline">@genre</span>
            }
        </div>
        <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:16px">
            <span class="detail-score">@Model.RatingText</span>
            <span class="muted" style="font-size:14px">/ 10 · @Model.ReviewCountText</span>
        </div>
        <p style="font-size:15px;line-height:1.6;max-width:60ch;margin:0 0 16px">@Model.Description</p>
        <p style="font-size:13px;opacity:.7;margin:0 0 20px"><strong>Cast:</strong> @Model.Cast</p>

        @if (isLoggedIn)
        {
            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="movieId" value="@Model.Id" />
                <button type="submit" class="btn @(Model.IsFavorite ? "btn-primary" : "btn-secondary")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>
                    @(Model.IsFavorite ? "In your favorites" : "Add to favorites")
                </button>
            </form>
        }
        else
        {
            <a class="btn btn-secondary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in to save favorites</a>
        }
    </div>
</div>

<hr class="hr" />

<section style="max-width:640px;margin:28px 0">
    <h2 style="font-size:18px;margin:0 0 12px">Your rating</h2>

    @if (isLoggedIn)
    {
        <form asp-controller="Reviews" asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MovieId" value="@Model.Id" />

            <fieldset style="border:0;padding:0;margin:0 0 10px">
                <legend class="visually-hidden" style="position:absolute;left:-9999px">Rating from 1 to 10</legend>
                <div class="rating-picker">
                    @for (var n = 1; n <= 10; n++)
                    {
                        var id = $"rating-{n}";
                        <span style="position:relative">
                            <input type="radio" id="@id" name="Rating" value="@n" checked="@(Model.ReviewForm.Rating == n)" />
                            <label class="rating-opt" for="@id">@n</label>
                        </span>
                    }
                </div>
            </fieldset>

            <textarea class="input" name="Text" rows="3" placeholder="Share your thoughts on this film…"
                      style="margin-bottom:10px">@Model.ReviewForm.Text</textarea>

            <div style="display:flex;gap:8px">
                <button type="submit" class="btn btn-primary">@(Model.HasOwnReview ? "Save changes" : "Post review")</button>
                @if (ownReview is not null)
                {
                    <button type="submit" form="delete-own-review-form" class="btn btn-secondary"
                            onclick="return confirm('Delete your review? This removes your rating and comments on it.');">Delete review</button>
                }
            </div>
        </form>

        @if (ownReview is not null)
        {
            <form id="delete-own-review-form" asp-controller="Reviews" asp-action="Delete" method="post" class="inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@ownReview.Id" />
                <input type="hidden" name="movieId" value="@Model.Id" />
            </form>
        }
    }
    else
    {
        <div class="card" style="max-width:420px">
            <p class="card-body" style="margin:0 0 10px">Log in to rate and review this film.</p>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in</a>
        </div>
    }
</section>

<hr class="hr" />

<section style="margin:28px 0">
    <h2 style="font-size:18px;margin:0 0 16px">Reviews (@Model.Reviews.Count)</h2>

    @if (Model.Reviews.Count > 0)
    {
        foreach (var review in Model.Reviews)
        {
            <article class="review">
                <div class="review-head">
                    <span class="avatar avatar-md">@review.AuthorInitials</span>
                    <span style="font-weight:600;font-size:14px">@review.AuthorName</span>
                    <span class="tag tag-accent">@review.RatingText</span>
                    <span class="muted" style="font-size:12px">@review.CreatedAt.ToString("MMM d, yyyy")</span>
                    @if (review.IsMine)
                    {
                        <span class="tag tag-neutral">Your review</span>
                    }
                    @if (review.CanModerate && !review.IsMine)
                    {
                        <form asp-controller="Reviews" asp-action="Delete" method="post" class="inline-form"
                              onsubmit="return confirm('Delete this review and its comments?');"
                              style="margin-left:auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@review.Id" />
                            <input type="hidden" name="movieId" value="@Model.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                        </form>
                    }
                </div>

                <p class="review-text">@review.Text</p>

                <details open="@(review.Comments.Count > 0 ? "open" : null)">
                    <summary style="cursor:pointer;font-size:12px;font-weight:700">
                        @(review.Comments.Count == 0 ? "Add a comment" : $"Comments ({review.Comments.Count})")
                    </summary>
                    <div class="comments">
                        @foreach (var comment in review.Comments)
                        {
                            <div class="comment">
                                <span class="comment-author">@comment.AuthorName</span>
                                <span class="comment-date">@comment.CreatedAt.ToString("MMM d, yyyy")</span>
                                @if (comment.CanDelete)
                                {
                                    <form asp-controller="Reviews" asp-action="DeleteComment" method="post" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@comment.Id" />
                                        <input type="hidden" name="movieId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                                    </form>
                                }
                                <p>@comment.Text</p>
                            </div>
                        }

                        @if (isLoggedIn)
                        {
                            <form asp-controller="Reviews" asp-action="AddComment" method="post" class="comment-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ReviewId" value="@review.Id" />
                                <input class="input" name="Text" placeholder="Add a comment…" style="font-size:13px" required />
                                <button type="submit" class="btn btn-secondary">Post</button>
                            </form>
                        }
                        else
                        {
                            <p class="muted" style="font-size:13px;margin:0">
                                <a asp-controller="Account" asp-action="Login">Log in</a> to comment.
                            </p>
                        }
                    </div>
                </details>
            </article>
        }
    }
    else
    {
        <p class="empty">No reviews yet. Be the first to review this film.</p>
    }
</section>

@if (Model.Similar.Count > 0)
{
    <hr class="hr" />
    <section style="margin:28px 0 0">
        <h2 style="font-size:18px;margin:0 0 16px">You might also like</h2>
        <div class="rail">
            @foreach (var movie in Model.Similar)
            {
                <div><partial name="_MovieCard" model="movie" /></div>
            }
        </div>
    </section>
}
