@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section style="margin-bottom:32px">
    <h1 style="font-size:clamp(32px,4vw,48px);margin:0 0 8px">Find your next film.</h1>
    <p style="font-size:16px;max-width:60ch;opacity:.75;margin:0 0 20px">
        Browse ratings and reviews from the REEL community, or search for something specific.
    </p>
    <form asp-controller="Movies" asp-action="Index" method="get" style="display:flex;gap:8px;max-width:480px">
        <input class="input" type="search" name="q" placeholder="Search movies…" aria-label="Search movies" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</section>

<hr class="hr" />

<section class="section">
    <div class="section-head">
        <h2>Trending now</h2>
        <a class="btn btn-ghost" asp-controller="Movies" asp-action="Index">View all →</a>
    </div>
    <div class="rail">
        @foreach (var movie in Model.Trending)
        {
            <div><partial name="_MovieCard" model="movie" /></div>
        }
    </div>
</section>

<section class="section">
    <div class="section-head">
        <h2>Recently added</h2>
        <a class="btn btn-ghost" asp-controller="Movies" asp-action="Index" asp-route-sort="newest">View all →</a>
    </div>
    <div class="rail">
        @foreach (var movie in Model.Newest)
        {
            <div><partial name="_MovieCard" model="movie" /></div>
        }
    </div>
</section>

<section class="section">
    <div class="section-head">
        <h2>Top rated</h2>
        <a class="btn btn-ghost" asp-controller="Rankings" asp-action="Index">View all →</a>
    </div>
    <div class="rail">
        @foreach (var movie in Model.TopRated)
        {
            <div><partial name="_MovieCard" model="movie" /></div>
        }
    </div>
</section>

@if (Model.ShowRecommended)
{
    <section class="section">
        <div class="section-head">
            <h2>Recommended for you</h2>
            <span class="muted" style="font-size:12px">Based on movies you rated highly</span>
        </div>
        <div class="rail">
            @foreach (var movie in Model.Recommended)
            {
                <div><partial name="_MovieCard" model="movie" /></div>
            }
        </div>
    </section>
}
