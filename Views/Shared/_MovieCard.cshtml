@model MovieCardViewModel
@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<div class="movie-card">
    <a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Id" aria-label="@Model.Title">
        @if (!string.IsNullOrEmpty(Model.PosterUrl))
        {
            <span class="poster poster-img"><img src="@Model.PosterUrl" alt="@Model.Title poster" /></span>
        }
        else
        {
            <span class="poster">@Model.Title</span>
        }
    </a>

    @if (isLoggedIn)
    {
        <form asp-controller="Favorites" asp-action="Toggle" method="post" class="inline-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="movieId" value="@Model.Id" />
            <button type="submit"
                    class="fav-btn @(Model.IsFavorite ? "is-active" : "")"
                    title="@(Model.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                    aria-label="@(Model.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>
            </button>
        </form>
    }

    <div>
        <div class="movie-card-title">@Model.Title</div>
        <div class="movie-card-meta">@Model.Year · @Model.GenresText</div>
    </div>
    <div class="movie-card-foot">
        <span class="tag tag-accent">@Model.RatingText</span>
        <span class="movie-card-meta">@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")</span>
    </div>
</div>
